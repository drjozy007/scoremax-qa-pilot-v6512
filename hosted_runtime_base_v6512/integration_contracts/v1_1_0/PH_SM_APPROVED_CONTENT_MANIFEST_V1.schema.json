{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.scoremax.internal/v1.1/PH_SM_APPROVED_CONTENT_MANIFEST_V1.schema.json",
  "title": "Power House Approved Content Package Manifest v1 — schema 1.1.0",
  "type": "object",
  "properties": {
    "manifest_schema_version": {
      "const": "1.1.0"
    },
    "release_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "release_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_file": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "content_file_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "question_count": {
      "type": "integer",
      "minimum": 1
    },
    "stimulus_count": {
      "type": "integer",
      "minimum": 0
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size_bytes"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "manifest_schema_version",
    "release_id",
    "release_version",
    "generated_at",
    "content_file",
    "content_file_sha256",
    "question_count",
    "stimulus_count",
    "files"
  ]
}
