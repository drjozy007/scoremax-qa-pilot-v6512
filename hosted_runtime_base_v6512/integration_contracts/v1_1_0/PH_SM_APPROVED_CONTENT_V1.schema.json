                        "const": "ACADEMICALLY_READY"
                      },
                      "question_count": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "release_operation": {
                "const": "PUBLISH_SNAPSHOT"
              },
              "delivery_mode": {
                "const": "MANIFEST_PULL"
              }
            },
            "required": [
              "release_operation",
              "delivery_mode"
            ]
          },
          "then": {
            "properties": {
              "package_download_url": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              },
              "questions": {
                "type": "array",
                "maxItems": 0
              },
              "stimuli": {
                "type": "array",
                "maxItems": 0
