                      "withdrawal_reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "withdrawn_at",
                      "withdrawal_reason"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    }
