              "delivery_mode": {
                "const": "INLINE"
              },
              "package_download_url": {
                "type": "null"
              },
              "questions": {
                "type": "array",
                "maxItems": 0
              },
              "stimuli": {
                "type": "array",
                "maxItems": 0
              },
              "release": {
                "allOf": [
