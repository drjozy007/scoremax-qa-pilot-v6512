      "allOf": [
        {
          "if": {
            "properties": {
              "release_operation": {
                "const": "PUBLISH_SNAPSHOT"
              },
              "delivery_mode": {
                "const": "INLINE"
              }
            },
            "required": [
              "release_operation",
              "delivery_mode"
            ]
          },
          "then": {
            "properties": {
              "package_download_url": {
                "type": "null"
              },
