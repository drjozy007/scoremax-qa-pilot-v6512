{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "additionalProperties":false,
  "required":["message_id","contract_name","contract_version","schema_version","source_system","destination_system","occurred_at","sent_at","correlation_id","idempotency_key","producer_version","retry_of_message_id","payload_checksum_sha256","data_classification","payload"],
  "properties":{
    "message_id":{"type":"string","minLength":1,"maxLength":255},
    "contract_name":{"const":"SM_PH_CONTENT_DELIVERY_ACK_V1"},
    "contract_version":{"const":"1"},
    "schema_version":{"const":"1.0.0"},
    "source_system":{"const":"SCOREMAX"},
    "destination_system":{"const":"POWER_HOUSE"},
    "occurred_at":{"type":"string","format":"date-time"},
    "sent_at":{"type":"string","format":"date-time"},
    "correlation_id":{"type":"string","minLength":1,"maxLength":255},
    "idempotency_key":{"type":"string","minLength":1,"maxLength":500},
    "producer_version":{"type":"string","minLength":1,"maxLength":100},
    "retry_of_message_id":{"type":["string","null"],"maxLength":255},
    "payload_checksum_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
    "data_classification":{"const":"INTERNAL"},
    "payload":{
      "type":"object","additionalProperties":false,
      "required":["event_id","delivery_state","release_id","release_version","package_checksum_sha256","question_count","scoremax_release","release_authority_conferred"],
      "properties":{
        "event_id":{"type":"string","minLength":1,"maxLength":255},
        "delivery_state":{"enum":["IMPORTED_STAGED","ACTIVATED_LEARNER_LIVE"]},
        "release_id":{"type":"string","minLength":1,"maxLength":255},
        "release_version":{"type":"string","minLength":1,"maxLength":255},
        "package_checksum_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},
        "question_count":{"type":"integer","minimum":0},
        "scoremax_release":{"type":"string","minLength":1,"maxLength":100},
        "release_authority_conferred":{"const":false}
      }
    }
  }
}
